{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "minecraftservers": {
      "type": "object",
      "description" : "Configuration related for the Minecraft Servers",
      "properties" : {
        "allocation": {
          "type" : "object",
          "description" : "Configuration related to the allocation of servers",
          "properties" : {
            "defaultStrategy": {
              "type": "string",
              "enum" : ["players", "manual", "always"],
              "description" : "The default allocation strategy"
            }
          }
        }
      }
    },
    "proxyfleets": {
      "type": "object",
      "description" : "Configuration related for the Proxy Fleets",
      "properties" : {
        "allocation": {
          "type" : "object",
          "description" : "Configuration related to the allocation of proxy fleets",
          "properties" : {
            "defaultStrategy": {
              "type": "string",
              "enum" : ["players", "manual", "always"],
              "description" : "The default allocation strategy"
            }
          }
        }
      }
    }
  }
}
